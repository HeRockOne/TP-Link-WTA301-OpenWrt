#!/bin/sh /etc/rc.common
# WTA301 Wi-Fi 守护服务
#
# 这个服务的唯一目的：把「每天早上两个 Wi-Fi 消失、必须拔电源」这件事变成可取证 + 可自愈。
# 依赖 wta301-wifi-guard（见 /usr/sbin/）。细节与判据都在那个脚本的注释里。

START=95
STOP=05
USE_PROCD=1

start_service() {
	procd_open_instance guard
	procd_set_param command /usr/sbin/wta301-wifi-guard
	# 守护进程自己不该被 procd 反复重启 —— 它不退出。
	# 万一是被 OOM 打死的，这里能拉回来，而这本身就是一条线索。
	procd_set_param respawn 5 5 10
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
