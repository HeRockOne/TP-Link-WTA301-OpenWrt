#!/bin/sh /etc/rc.common
#
# net-tune 服务 —— 真正的逻辑在 /usr/sbin/net-tune（见该文件头部注释）
#
# 为什么需要它而不是纯 sysctl / 纯 uci：
#   - netdev_budget / rps_sock_flow_entries  → sysctl.d 就够（99-wta301-net.conf）
#   - packet_steering / steering_flows        → uci（uci-defaults/99-wta301-net）
#   - **eth0 的 IRQ 亲和性 → 只能用脚本**：IRQ 号每次启动会变，必须按名字查
#     /proc/interrupts，而且 DSA 交换机 probe 完成前 eth0 还不存在。

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/net-tune
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
