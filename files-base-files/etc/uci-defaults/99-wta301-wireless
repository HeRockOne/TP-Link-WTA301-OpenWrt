#!/bin/sh
# 99-wta301-wireless —— 兜底：把无线配置落到出厂最优值并启用。
#
# ⚠ 首选机制不是本脚本，而是 base-files/etc/config/wireless（固化进 rootfs）。
# 本脚本只是第二层保险（例如有人 rm /etc/config/wireless 后重启）。
#
# 为什么不能只靠 uci-defaults（本板实测，已踩过）
# ----------------------------------------------
# 25.12 的 /etc/init.d/boot 顺序是：
#     48: [ -f /etc/board.json ] && /sbin/wifi config     ← 先
#     52: uci_apply_defaults                              ← 后
# 而 ath11k 是模块，dmesg 显示它 16~22 s 才 probe（`ath11k c000000.wifi:
# ipq5018 hw1.0` / `ath11k b00a040.wifi: qcn6122 hw1.0`）。第 48 行跑的时候
# 两个 phy 还不存在，`wifi config` 什么也不生成，`/etc/config/wireless` 此时
# 根本不存在 ⇒ 本脚本首行 `[ -f /etc/config/wireless ] || exit 0` 直接退出，
# 一个 uci set 都没执行。等 phy 出现后 hotplug 才补生成那份带
# `option disabled '1'` 的配置（wifi-scripts 的安全默认）。
# 实测证据：刷 P8 后 /etc/uci-defaults 已空（脚本被执行并删除）、
# `sh -x /rom/etc/uci-defaults/99-wta301-wireless` 手工跑逐条 uci set 全成功，
# 但冷启动后 /etc/config/wireless 里仍是 `option disabled '1'`。
#
# 所以固化版 base-files/etc/config/wireless 才是主机制（S7 也是 rootfs 固化，
# 见 docs/DIVERGENCE-MATRIX.md 的 L6 行）。固化配置文件由 fstools 首启 seed 到
# overlay，第 48 行的 `wifi config` 会按 option path 匹配到已有段，不重建。
#
# 配置取值（P24 实测，见 docs/P24-WIFI-5G-PERF.md）
# ------------------------------------------------
#   radio0 (2g): ssid OpenWrt-WTA301     ch6  HT40 noscan cell_density 2  country CN
#   radio1 (5g): ssid OpenWrt-WTA301-5G  ch161 HE80       cell_density 2  country CN
#   两个 iface : mode ap / network lan / encryption psk2 / key 123456789
#
# 为什么 5G 用 161 不用 36：CN 非 DFS 段，避 CAC；36 也非 DFS 但实测同一套
# 参数下 161 表现更稳。为什么不用 HE160：本机客户端只 80MHz，开 160 后信道
# busy 0.4%→63%、expected 887→551。为什么 2.4G 要 noscan：不加就被
# "overlapping BSSes" 压回 20MHz + CTS protection，实测仅 ~20 Mbps。
#
# 安全提示（务必让用户知道）
# --------------------------
# 默认 PSK 与 S7 基线相同，属于"已知密码"。首次登录后应改成自己的：
#     uci set wireless.default_radio0.key='新密码'
#     uci set wireless.default_radio1.key='新密码'
#     uci commit wireless && wifi reload
#
# 幂等：重复设置同一值无副作用。

[ -f /etc/config/wireless ] || exit 0

KEY='123456789'

# 找出 device == $1 的 wifi-iface 段名
ifaces_for() {
	local i
	for i in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
		[ "$(uci -q get "wireless.$i.device")" = "$1" ] && echo "$i"
	done
}

apply_radio() {
	local sec="$1" band="$2" chan htmode ssid noscan i

	case "$band" in
	2g) chan=6;   htmode='HT40'; ssid='OpenWrt-WTA301';    noscan=1 ;;
	5g) chan=161; htmode='HE80'; ssid='OpenWrt-WTA301-5G'; noscan=0 ;;
	*)  return 0 ;;
	esac

	uci set "wireless.$sec.disabled=0"
	uci set "wireless.$sec.country=CN"
	uci set "wireless.$sec.channel=$chan"
	uci set "wireless.$sec.htmode=$htmode"
	uci set "wireless.$sec.cell_density=2"
	# 不写 txpower：驱动默认即 BDF 上限 24 dBm（设 24~33 都回落 24，设 20 才降到 20）
	if [ "$noscan" = "1" ]; then
		uci set "wireless.$sec.noscan=1"
	else
		uci -q delete "wireless.$sec.noscan"
	fi

	for i in $(ifaces_for "$sec"); do
		uci set "wireless.$i.disabled=0"
		uci set "wireless.$i.network=lan"
		uci set "wireless.$i.mode=ap"
		uci set "wireless.$i.ssid=$ssid"
		uci set "wireless.$i.encryption=psk2"
		uci set "wireless.$i.key=$KEY"
	done
}

for s in $(uci show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	band=$(uci -q get "wireless.$s.band")
	[ -n "$band" ] || band=2g
	apply_radio "$s" "$band"
done

uci commit wireless
exit 0
