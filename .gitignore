# 构建输出
/build/
/build-*/
*.log

# 大二进制（固件镜像、ImageBuilder tarball、apk 缓存）
*.bin
*.img
*.itb
*.squashfs
*.tar.zst
*.tar.gz
*.apk

# 发布包目录（由 deliver/make-open-release.sh 生成，走 Releases 页）
/release/
/release-*/

# 证据日志保留
!docs/evidence/*.txt

# BDF：board-2.bin 装的是【逐台】射频校准数据（从 ART 分区提取），
# 属于厂商烧进 flash 的数据 —— 仓库故意不分发（THIRD-PARTY.md §2）。
# 使用者用自己的 ART 生成后放在 patches/bdf/，该目录已 gitignore，不会误入库。
patches/bdf/*.bin

# 本地临时物
__pycache__/
*.pyc
*.tmp
*.orig
*.rej
.DS_Store
Thumbs.db
