+++ b/drivers/net/wireless/ath/ath11k/core.h	2026-11-15 00:48:22.963976064 +0800
@@ -59,6 +59,7 @@
 
 extern unsigned int ath11k_frame_mode;
 extern bool ath11k_ftm_mode;
+extern bool ath11k_monitor_all;
 
 #define ATH11K_SCAN_TIMEOUT_HZ (20 * HZ)
 
--- a/drivers/net/wireless/ath/ath11k/mac.c	2026-11-15 00:48:22.931976063 +0800
+++ b/drivers/net/wireless/ath/ath11k/mac.c	2026-11-15 00:48:22.971976064 +0800
@@ -10477,7 +10477,7 @@
 		goto err_free_if_combs;
 	}
 
-	if (!ab->hw_params.supports_monitor)
+	if (!ab->hw_params.supports_monitor && !ath11k_monitor_all)
 		/* There's a race between calling ieee80211_register_hw()
 		 * and here where the monitor mode is enabled for a little
 		 * while. But that time is so short and in practise it make
